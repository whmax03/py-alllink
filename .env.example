# Supabase 数据库连接
DATABASE_URL="postgresql+psycopg://postgres.[项目ID]:[密码]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[项目ID]:[密码]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# 赛狐 API 全局参数
SELLFOX_CLIENT_ID=你的APPID
SELLFOX_CLIENT_SECRET=你的client_secret
